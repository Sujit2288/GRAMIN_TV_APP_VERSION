private void handleStatus(String status, String telegram) {

    switch (ACTIVE) {

        case "UNDER_CONSTRUCTION":
            showUnderConstruction(telegram);
            break;

        case "SERVER_DOWN":
            showServerDown(telegram);
            break;

        case "NEW_VERSION_AVAILABLE":
            showUpdateRequired(https://github.com/Sujit2288/GRAMIN_TV_APP_VERSION/raw/refs/heads/main/com.gramintv.in_v1.5.apk);
            break;

        case "ACTIVE":
            handleActive();
            break;

        default:
            showServerDown(telegram);
            break;
    }
